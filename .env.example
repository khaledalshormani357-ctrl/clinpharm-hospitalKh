# Server-only Gemini API key. Never prefix this with VITE_.
GEMINI_API_KEY="SET_IN_SERVER_RUNTIME_SECRET"

# Supabase Auth validation for the clinical copilot API.
# These are the public project URL and anon key; no service-role key is needed.
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_ANON_KEY="YOUR_PUBLIC_ANON_KEY"

# Comma-separated exact browser origins allowed to read API responses.
# Example: https://YOUR_GITHUB_USERNAME.github.io
# Native Capacitor origins are allowlisted by the server; add your exact hosted web origin here.
CORS_ALLOWED_ORIGINS="https://YOUR_GITHUB_USERNAME.github.io"

# Optional hosting URL used by the app for self-referential links.
APP_URL="https://YOUR_SERVER_HOST"
